;; expect: accept
;; out: 7 1002011 19040505062021 111
;; spec/lir.md 4.6: a module macro whose splice arms another and then includes a file: the include acts in the collected region as a
;; written one does, collected and then its file's forms after it, before the rest of the splice. rearm returns (BEGIN (MODULE-MACRO
;; census) (INCLUDE "module-include-part.lir") FORM..), so census (module-include-lib.lir) is given the include (made by rearm: this
;; file, digit 1, at the use, line 19), part-a, the nested include, nested and part-b (lines 4, 5, 5, 6; module-include-part.lir, 23
;; bytes of name against 24: digit 0, and module-include-nested.lir, digit 2), then the declare and main of this file (digit 1; lines
;; 20 and 21).
(REQUIRE-MACROS "module-include-lib.lir")
(DEFINE-MACRO rearm (forms ...)
  (BLOCK entry
    (LET ((out (CALL (GLOBAL lir.macro.triple)
                 (CALL (GLOBAL lir.sexp.symbol) (STRING "BEGIN"))
                 (CALL (GLOBAL lir.macro.pair) (CALL (GLOBAL lir.sexp.symbol) (STRING "MODULE-MACRO")) (CALL (GLOBAL lir.sexp.symbol) (STRING "census")))
                 (CALL (GLOBAL lir.macro.pair) (CALL (GLOBAL lir.sexp.symbol) (STRING "INCLUDE")) (CALL (GLOBAL lir.sexp.string) (STRING "module-include-part.lir"))))))
      (CALL (GLOBAL lir.sexp.push) out (CALL (GLOBAL lir.sexp.nth) forms (I64 0)))
      (CALL (GLOBAL lir.sexp.push) out (CALL (GLOBAL lir.sexp.nth) forms (I64 1)))
      (RET out))))
(MODULE-MACRO rearm)
(DECLARE printf I32 (PTR ...))
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (CALL (GLOBAL census-count)) (CALL (GLOBAL census-files)) (CALL (GLOBAL census-lines))
      (ADD (CALL (GLOBAL part-a)) (ADD (CALL (GLOBAL nested)) (CALL (GLOBAL part-b)))))
    (RET (I32 0))))
