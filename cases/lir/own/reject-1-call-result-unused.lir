;; expect: reject
;; own: verify
;; error: 15:7: error: ownership rule 1: owned d is leaked at ret
;; spec/lir.md 6.14.5 rule 1: d, bound by let to a call's owned result and never used, is live at ret. The function has no other
;; managed value (gloss chunk 0, own/lk/leakA.lir `leaky`).
(IMPORT "import-base.lir")
(DEFINE (mk (PTR (ADDRSPACE 1))) ()
  (BLOCK entry
    (LET ((x (ALLOC-OBJECT (STRUCT box) (I32 7))))
      (STORE INIT ((PTR (ADDRSPACE 1)) NULL) (GETELEMENTPTR (STRUCT box) x (I32 0) (I32 2)))
      (RET x))))
(DEFINE (main I32) ()
  (BLOCK entry
    (LET ((d (CALL (GLOBAL mk))))
      (RET (I32 0)))))
