;; expect: reject
;; own: verify
;; error: 14:5: error: ownership rule 1: an owned value with no name is leaked: bind it or consume it
;; spec/lir.md 6.14.2, 6.14.5 rule 1: a call whose result is (ptr 1) defines an owned value; dropped as a statement, nothing consumes
;; it. The function has no other managed value, which the verifier once took for a function without one and skipped (gloss chunk 0).
(IMPORT "import-base.lir")
(DEFINE (mk (PTR (ADDRSPACE 1))) ()
  (BLOCK entry
    (LET ((x (ALLOC-OBJECT (STRUCT box) (I32 7))))
      (STORE INIT ((PTR (ADDRSPACE 1)) NULL) (GETELEMENTPTR (STRUCT box) x (I32 0) (I32 2)))
      (RET x))))
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL mk)) (RET (I32 0))))
