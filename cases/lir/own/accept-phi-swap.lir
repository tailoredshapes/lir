;; expect: accept
;; own: verify
;; out: swap-g 40
;; out: swap-o 40
;; out: free 1
;; out: free 2
;; spec/lir.md 6.14.2: two phis that name each other, a swap of two loop variables, are resolved together (the least fixed point over the
;; phis whose entries are not all known yet): each takes the kind of the values entering the cycle, so the address of a field of either is an interior address and a load
;; through it is accepted (plain, `load copy`, `load borrow`).
(declare printf i32 (ptr ...))
(declare malloc ptr (i64))
(declare free void (ptr))
(defstruct hdr (i64 i32 i32))
(defstruct box (%struct.hdr i64 (ptr 1)))
(ownership (retain @rt.retain) (release @rt.release) (unique @rt.unique) (alloc @rt.alloc) (stack-init @rt.stack-init) (stack-end @rt.stack-end) (header %struct.hdr))
(define unsafe internal (rt.alloc ptr) ((i64 size) (i32 tid))
  (block entry
    (let ((p (call @malloc size)))
      (store (i64 1) (getelementptr %struct.hdr p (i32 0) (i32 0)))
      (store tid (getelementptr %struct.hdr p (i32 0) (i32 1)))
      (store (i32 0) (getelementptr %struct.hdr p (i32 0) (i32 2)))
      (ret p))))
(define unsafe internal (rt.retain void) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) done inc))
  (block inc
    (let ((c (getelementptr %struct.hdr p (i32 0) (i32 0))))
      (store (add (load i64 c) (i64 1)) c)
      (ret)))
  (block done (ret)))
(define unsafe internal (rt.release void) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) done dec))
  (block dec
    (let ((c (getelementptr %struct.hdr p (i32 0) (i32 0)))
          (n (sub (load i64 c) (i64 1))))
      (store n c)
      (br (icmp eq n (i64 0)) gone done)))
  (block gone
    (call @printf (string "free %d\n") (load i32 (getelementptr %struct.hdr p (i32 0) (i32 1))))
    (call @free p)
    (ret))
  (block done (ret)))
(define unsafe internal (rt.unique i1) ((ptr p))
  (block entry (ret (icmp eq (load i64 (getelementptr %struct.hdr p (i32 0) (i32 0))) (i64 1)))))
(define unsafe internal (rt.stack-init void) ((ptr p) (i32 tid))
  (block entry
    (store (i64 0) (getelementptr %struct.hdr p (i32 0) (i32 0)))
    (store tid (getelementptr %struct.hdr p (i32 0) (i32 1)))
    (store (i32 4) (getelementptr %struct.hdr p (i32 0) (i32 2)))
    (ret)))
(define unsafe internal (rt.stack-end void) ((ptr p))
  (block entry
    (call @printf (string "stack-end %d\n") (load i32 (getelementptr %struct.hdr p (i32 0) (i32 1))))
    (ret)))
(define internal (swap-g i64) (((ptr 1) p) ((ptr 1) q) (i64 n))
  (block entry (br again))
  (block again
    (let ((i (phi i64 (entry (i64 0)) (again j)))
          (acc (phi i64 (entry (i64 0)) (again acc2)))
          (a (phi (ptr 1) (entry p) (again b)))
          (b (phi (ptr 1) (entry q) (again a)))
          (g (getelementptr %struct.box a (i32 0) (i32 1)))
          (v (load i64 g))
          (h (getelementptr %struct.box a (i32 0) (i32 2)))
          (c (load copy (ptr 1) h))
          (d (load borrow (ptr 1) h))
          (acc2 (add acc v))
          (j (add i (i64 1))))
      (destroy-value c)
      (br (icmp slt j n) again done)))
  (block done (ret acc2)))
(define internal (swap-o i64) (((ptr 1) owned p) ((ptr 1) owned q) (i64 n))
  (block entry (br again))
  (block again
    (let ((i (phi i64 (entry (i64 0)) (again j)))
          (acc (phi i64 (entry (i64 0)) (again acc2)))
          (a (phi (ptr 1) (entry p) (again b)))
          (b (phi (ptr 1) (entry q) (again a)))
          (g (getelementptr %struct.box a (i32 0) (i32 1)))
          (v (load i64 g))
          (h (getelementptr %struct.box a (i32 0) (i32 2)))
          (c (load copy (ptr 1) h))
          (acc2 (add acc v))
          (j (add i (i64 1))))
      (destroy-value c)
      (br (icmp slt j n) again done)))
  (block done (destroy-value a) (destroy-value b) (ret acc2)))
(define (main i32) ()
  (block entry
    (let ((p (alloc-object %struct.box (i32 1)))
          (q (alloc-object %struct.box (i32 2))))
      (store (i64 10) (getelementptr %struct.box p (i32 0) (i32 1)))
      (store init ((ptr 1) null) (getelementptr %struct.box p (i32 0) (i32 2)))
      (store (i64 20) (getelementptr %struct.box q (i32 0) (i32 1)))
      (store init ((ptr 1) null) (getelementptr %struct.box q (i32 0) (i32 2)))
      (call @printf (string "swap-g %lld\n") (call @swap-g p q (i64 3)))
      (call @printf (string "swap-o %lld\n") (call @swap-o (copy-value p) (copy-value q) (i64 3)))
      (destroy-value p)
      (destroy-value q)
      (ret (i32 0)))))
